<services>
  <service name="obs_scm">
    <param name="url">https://github.com/df7cb/postgresql-unit.git/</param>
    <param name="scm">git</param>
    <param name="revision">%!{PG_UNIT_VERSION}</param>
    <param name="match-tag">[0-9]*</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">(.*)</param>
    <param name="filename">percona-postgresql-unit_%!{PG_MAJOR_VERSION}</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">percona-postgresql-unit_%!{PG_MAJOR_VERSION}</param>
  </service>
</services>
