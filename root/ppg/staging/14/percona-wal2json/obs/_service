<services>
  <service name="obs_scm">
    <param name="url">https://github.com/eulerto/wal2json.git</param>
    <param name="scm">git</param>
    <param name="revision">%!{WAL2JSON_TAG}</param>
    <param name="version">%!{WAL2JSON_VERSION}</param>
    <param name="filename">percona-wal2json</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version" />
</services>
