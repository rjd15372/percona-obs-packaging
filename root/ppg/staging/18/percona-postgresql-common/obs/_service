<services>
  <service name="obs_scm">
    <param name="url">https://salsa.debian.org/postgresql/postgresql-common.git</param>
    <param name="scm">git</param>
    <param name="revision">debian/%!{POSTGRESQL_COMMON_VERSION}</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">debian/(.*)</param>
    <param name="filename">percona-postgresql-common</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version" />
</services>
