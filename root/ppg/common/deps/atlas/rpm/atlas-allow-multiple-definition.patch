Allow multiple definitions when linking ATLAS shared libraries.

ATLAS 3.10.3 includes both arch-specific and mutex-fallback implementations
of atomic functions (e.g. ATL_SetAtomicCount) in the same libatlas.a.
When --whole-archive is used to build shared libs, modern ld (binutils 2.35+
as shipped in UBI 9 / RHEL 9) rejects the resulting duplicate symbols.

Pass --allow-multiple-definition so the linker picks the first definition
(arch-specific wins, same behaviour as old toolchains).

--- a/makes/Make.lib
+++ b/makes/Make.lib
@@ -119,13 +119,15 @@ LDTRY:
 GCCTRY:
 	$(GOODGCC) -shared -o $(outso).$(so_ver)  \
            \
            -Wl,-soname,"$(outso).$(so_ver_major)" \
+           -Wl,--allow-multiple-definition \
            -Wl,--whole-archive $(libas) -Wl,--no-whole-archive $(LIBS)
 	  ln -s $(outso).$(so_ver) $(outso).$(so_ver_major)
 	  ln -s $(outso).$(so_ver) $(outso)
 GCCTRY_norp:
 	$(GOODGCC) -shared -o $(outso)  \
+           -Wl,--allow-multiple-definition \
            -Wl,--whole-archive $(libas) -Wl,--no-whole-archive $(LIBS)
