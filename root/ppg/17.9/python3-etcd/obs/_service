<services>
  <service name="obs_scm">
    <param name="url">${PERCONA_OBS_PACKAGING_REPO}</param>
    <param name="scm">git</param>
    <param name="revision">${PERCONA_OBS_PACKAGING_BRANCH}</param>
    <param name="version">_none_</param>
    <param name="extract">*</param>
    <param name="subdir">root/ppg/17.9/python3-etcd/rpm</param>
    <param name="filename">rpm</param>
  </service>

  <service name="obs_scm">
    <param name="url">https://github.com/jplana/python-etcd.git</param>
    <param name="scm">git</param>
    <param name="revision">0.4.5</param>
    <param name="version">0.4.5</param>
    <param name="filename">python3-etcd</param>
  </service>

  <service mode="buildtime" name="tar" />

  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>

  <service mode="buildtime" name="set_version" />
</services>
