<services>
  <service name="obs_scm">
    <param name="url">https://github.com/timescale/pgvectorscale.git/</param>
    <param name="scm">git</param>
    <param name="revision">%!{PGVECTORSCALE_VERSION}</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">(.*)</param>
    <param name="filename">percona-pgvectorscale_%!{PG_MAJOR_VERSION}</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">percona-pgvectorscale_%!{PG_MAJOR_VERSION}</param>
  </service>
  <service mode="buildtime" name="cargo_vendor">
    <param name="src">percona-pgvectorscale_*.tar.gz</param>
    <param name="compression">gz</param>
  </service>
</services>
