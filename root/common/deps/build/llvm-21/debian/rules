#!/usr/bin/make -f
export DH_VERBOSE=1

OBS_SOURCES := /usr/src/packages/SOURCES
LLVM_UPSTREAM_VER := 21.1.5~++20251023083244+45afac62e373-1~exp1~20251023083401.50
DEB_ARCH := $(shell dpkg --print-architecture)

DEBS := libllvm21 llvm-21-runtime llvm-21-linker-tools libclang-cpp21 \
	libclang-common-21-dev libclang1-21 libc++abi1-21 libc++1-21 \
	libc++abi-21-dev libc++-21-dev llvm-21-tools llvm-21 llvm-21-dev clang-21

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_strip:
override_dh_compress:
override_dh_shlibdeps:
override_dh_dwz:
override_dh_usrlocal:
override_dh_strip_nondeterminism:

override_dh_auto_install:
	@set -e; \
	for pkg in $(DEBS); do \
	  deb="$(OBS_SOURCES)/$${pkg}_$(LLVM_UPSTREAM_VER)_$(DEB_ARCH).deb"; \
	  test -f "$$deb" || { echo "missing $$deb" >&2; exit 1; }; \
	  dpkg-deb -x "$$deb" "debian/$${pkg}/"; \
	done

override_dh_builddeb:
	dh_builddeb -- -Zgzip
