#!/usr/bin/make -f
export DH_VERBOSE=1

OBS_SOURCES := /usr/src/packages/SOURCES
LLVM_UPSTREAM_VER := 14.0.6~++20230131082216+f28c006a5895-1~exp1~20230131082247.218
DEB_ARCH := $(shell dpkg --print-architecture)

DEBS := libllvm14 llvm-14-runtime llvm-14-linker-tools libclang-cpp14 \
	libclang1-14 llvm-14-tools llvm-14 llvm-14-dev clang-14
ALL_DEBS := libclang-common-14-dev

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_strip:
override_dh_compress:
override_dh_shlibdeps:
override_dh_dwz:
override_dh_usrlocal:
override_dh_strip_nondeterminism:

override_dh_auto_install:
	@set -e; \
	for pkg in $(DEBS); do \
	  deb="$(OBS_SOURCES)/$${pkg}_$(LLVM_UPSTREAM_VER)_$(DEB_ARCH).deb"; \
	  test -f "$$deb" || { echo "missing $$deb" >&2; exit 1; }; \
	  dpkg-deb -x "$$deb" "debian/$${pkg}/"; \
	done; \
	for pkg in $(ALL_DEBS); do \
	  deb="$(OBS_SOURCES)/$${pkg}_$(LLVM_UPSTREAM_VER)_all.deb"; \
	  test -f "$$deb" || { echo "missing $$deb" >&2; exit 1; }; \
	  dpkg-deb -x "$$deb" "debian/$${pkg}/"; \
	done

override_dh_builddeb:
	dh_builddeb -- -Zgzip
