<?xml version="1.0" encoding="utf-8"?>
<!-- OBS-AddTag: percona-ubi-minimal:8-%RELEASE% percona-ubi-minimal:8 -->
<!-- OBS-Imagerepo: obsrepositories:/ -->
<image schemaversion="7.4" name="percona-ubi8-minimal-image">
  <description type="system">
    <author>Percona</author>
    <contact>info@percona.com</contact>
    <specification>Percona UBI 8 Minimal Container Image</specification>
  </description>
  <preferences>
    <type image="docker">
      <containerconfig name="percona-ubi8-minimal" tag="latest"/>
    </type>
    <version>8.0.0</version>
    <packagemanager>dnf</packagemanager>
  </preferences>
  <repository type="rpm-md">
    <source path="obsrepositories:/"/>
  </repository>
  <packages type="bootstrap">
    <package name="alternatives"/>
    <package name="bash"/>
    <package name="coreutils-single"/>
    <package name="microdnf"/>
    <package name="filesystem"/>
    <package name="glibc-minimal-langpack"/>
    <package name="redhat-release"/>
    <package name="rpm"/>
    <package name="sed"/>
    <package name="setup"/>
    <package name="systemd-libs"/>
    <package name="rootfiles"/>
    <package name="libusbx"/>
    <package name="langpacks-en"/>
  </packages>
</image>
